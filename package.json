{
  "name": "browserpilot",
  "version": "0.7.0",
  "private": true,
  "description": "Browser for agents. One process, many environments.",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "preview": "electron-vite preview",
    "cli:build": "node scripts/build-cli.mjs",
    "dist": "npm run cli:build && electron-vite build && electron-builder --publish never",
    "dist:win": "npm run cli:build && electron-vite build && electron-builder --win --publish never",
    "deploy:win": "powershell -ExecutionPolicy Bypass -File scripts/deploy-local.ps1",
    "dist:mac": "npm run cli:build && electron-vite build && electron-builder --mac --publish never",
    "dist:linux": "npm run cli:build && electron-vite build && electron-builder --linux --publish never"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@xyflow/react": "^12.12.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "lucide-react": "^0.544.0",
    "radix-ui": "^1.6.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "shadcn": "^4.21.0",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.24.6",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "electron": "^44.4.5",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  },
  "build": {
    "appId": "app.browserpilot.desktop",
    "productName": "BrowserPilot",
    "executableName": "BrowserPilot",
    "copyright": "Copyright © BrowserPilot",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "cli/dist",
        "to": "cli",
        "filter": [
          "browserpilot",
          "browserpilot.exe"
        ]
      },
      {
        "from": "resources/captcha",
        "to": "captcha",
        "filter": [
          "*.py"
        ]
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "linux": {
      "category": "Development",
      "maintainer": "BrowserPilot",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
